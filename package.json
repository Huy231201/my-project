{
  "name": "herond-portal-fe",
  "version": "1.0.0",
  "description": "herond-portal-fe",
  "license": "MIT",
  "author": "dangdn<dangdn.herond@gmail.com>",
  "keywords": [
    "react",
    "boilerplate",
    "typescript",
    "starter",
    "vite",
    "redux",
    "material-ui",
    "rrd",
    "prettier"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/herondlabs/herond-portal-fe.git"
  },
  "bugs": {
    "url": "https://github.com/herondlabs/herond-portal-fe/issues"
  },
  "homepage": "https://github.com/herondlabs/herond-portal-fe#readme",
  "scripts": {
    "dev": "vite --open",
    "start": "vite --open --mode dev",
    "host": "vite --open --host",
    "build:dev": "tsc && vite build --mode dev",
    "build:prod": "tsc && vite build --mode prod",
    "preview": "vite preview",
    "check-types": "tsc --noEmit",
    "lint": "eslint src --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint src --ext .js,.jsx,.ts,.tsx --fix && prettier \"src/**/*.{js,jsx,ts,tsx,css,scss}\" --write",
    "format": "prettier \"src/**/*.{js,jsx,ts,tsx,css,scss}\" --write",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cover": "vitest run --coverage",
    "test:e2e": "pnpm preview:test 'cypress open'",
    "test:e2e:headless": "pnpm preview:test 'cypress run'",
    "test:e2e:ci": "vite build && pnpm preview:test 'cypress run --record'",
    "prepare": "husky install"
  },
  "husky": {
    "hooks": {
      "pre-commit": "tsc --noEmit && lint-staged"
    }
  },
  "dependencies": {
    "@emotion/react": "^11.11.1",
    "@emotion/styled": "^11.11.0",
    "@mui/icons-material": "^5.14.1",
    "@mui/lab": "^5.0.0-alpha.138",
    "@mui/material": "^5.14.1",
    "@mui/styles": "^5.14.3",
    "@reduxjs/toolkit": "^1.9.5",
    "axios": "^1.5.0",
    "chart.js": "^4.3.3",
    "dayjs": "^1.11.9",
    "i18next": "^19.8.5",
    "i18next-browser-languagedetector": "^6.1.1",
    "i18next-http-backend": "^1.2.1",
    "lodash.merge": "^4.6.2",
    "query-string": "^8.1.0",
    "react": "^18.2.0",
    "react-chartjs-2": "^5.2.0",
    "react-datepicker": "^4.16.0",
    "react-dom": "^18.2.0",
    "react-hot-toast": "^2.4.1",
    "react-i18next": "^11.8.5",
    "react-redux": "^8.1.1",
    "react-router-dom": "^6.14.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^17.7.1",
    "@commitlint/config-conventional": "^17.7.0",
    "@andylacko/vite-svg-react-loader": "^3.0.4",
    "@babel/core": "^7.22.9",
    "@types/chart.js": "^2.9.37",
    "@types/lodash.merge": "^4.6.7",
    "@types/react": "^18.2.15",
    "@types/react-datepicker": "^4.15.0",
    "@types/react-dom": "^18.2.7",
    "@typescript-eslint/eslint-plugin": "^5.52.0",
    "@typescript-eslint/parser": "^6.1.0",
    "@vitejs/plugin-react-swc": "^3.3.2",
    "eslint": "^8.0.1",
    "eslint-config-airbnb-typescript": "7.2.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-config-standard-with-typescript": "^37.0.0",
    "eslint-import-resolver-typescript": "^3.5.5",
    "eslint-plugin-import": "^2.25.2",
    "eslint-plugin-jsx-a11y": "^6.7.1",
    "eslint-plugin-n": "^15.0.0 || ^16.0.0 ",
    "eslint-plugin-prettier": "^5.0.0",
    "eslint-plugin-promise": "^6.0.0",
    "eslint-plugin-react": "^7.33.1",
    "eslint-plugin-react-hooks": "^4.6.0",
    "husky": "^8.0.3",
    "lint-staged": "11.1.4",
    "prettier": "^3.0.0",
    "react-intersection-observer": "^9.5.2",
    "typescript": "*",
    "unplugin-auto-import": "^0.15.3",
    "vite": "^4.4.6",
    "vite-plugin-require": "^1.1.10",
    "vitest": "^0.33.0"
  }
}
