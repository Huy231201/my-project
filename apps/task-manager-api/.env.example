# Copy this file to .env and adjust the values: cp .env.example .env

# Port the API listens on
PORT=3000

# Origin of the web app allowed by CORS
CORS_ORIGIN=http://localhost:5173

# PostgreSQL connection string: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Use the user, password and database from the postgres service in compose.yaml
DATABASE_URL="postgresql://your_user:your_password@localhost:5432/your_database"

# Secret used to sign JWTs. Generate with: openssl rand -hex 32
JWT_SECRET=change_me

# Access token lifetime in minutes
JWT_EXPIRES_IN_MINUTES=15
